@import "colors.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "Aplicativos";
    display-run: "Executar";
    display-window: "Janelas";
    font: "DejaVu Sans 11";
}

window {
    width: 40%;
    location: center;
    anchor: center;
    border: 2px;
    border-color: @border;
    border-radius: 14px;
    background-color: @background;
    padding: 18px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    background-color: @surface;
    text-color: @text;
    border-radius: 9px;
    padding: 12px 14px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Pesquisar";
    placeholder-color: @muted;
    text-color: @text;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    spacing: 4px;
    background-color: transparent;
}

element {
    padding: 9px 11px;
    spacing: 10px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @text;
}

element selected {
    background-color: @accent;
    text-color: @background;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
