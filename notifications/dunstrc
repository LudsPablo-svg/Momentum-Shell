[global]
    font = "DejaVu Sans 10"
    width = (300, 420)
    height = 160
    origin = top-right
    offset = (16, 48)
    padding = 10
    horizontal_padding = 12
    frame_width = 1
    frame_color = "#80B918"
    separator_color = "#404040"
    background = "#1B1B1B"
    foreground = "#E0E0E0"
    corner_radius = 4
    sort = yes
    indicate_hidden = yes

[urgency_low]
    background = "#252525"
    foreground = "#A0A0A0"
    frame_color = "#404040"
    timeout = 5

[urgency_normal]
    background = "#252525"
    foreground = "#E0E0E0"
    frame_color = "#80B918"
    timeout = 6

[urgency_critical]
    background = "#252525"
    foreground = "#E0E0E0"
    frame_color = "#D9534F"
    timeout = 0
